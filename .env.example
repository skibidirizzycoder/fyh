# Copy to .env (never commit .env). Read by the server only, via process.env.
# SNOWFLAKE_ACCOUNT: account identifier, e.g. myorg-myaccount
# SNOWFLAKE_TOKEN: programmatic access token (PAT)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
# OPENAI_API_KEY: only for `npm run art` (makes textures on your machine; never sent to players)
OPENAI_API_KEY=
