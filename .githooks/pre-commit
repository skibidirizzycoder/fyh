#!/bin/sh
# pre-commit — refuses the commit unless `npm run check` passes
# (type check, lint, unit tests). Installed by `npm install` (the "prepare" script).
echo "pre-commit: running npm run check..."
if ! npm run check --silent; then
  echo ""
  echo "pre-commit: BLOCKED. 'npm run check' failed. Fix the errors above, then commit again."
  exit 1
fi
