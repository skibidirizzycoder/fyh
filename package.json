{
  "name": "flip-phone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint . --max-warnings=0 && vitest run",
    "smoke": "node scripts/smoke.ts",
    "gate": "npm run check && npm run smoke",
    "prepare": "git config core.hooksPath .githooks || echo \"prepare: not a git repository, so the pre-commit hook was not installed\"",
    "snowflake:ping": "node scripts/snowflake-ping.ts",
    "ship": "node scripts/ship.ts",
    "checkpoint": "node scripts/checkpoint.ts make",
    "checkpoint:play": "node scripts/checkpoint.ts play",
    "art": "node scripts/art.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.6",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
